# =============================================================================
# n8n-llm-token-spend-circuit-breaker-cost-allocator :: environment template
# -----------------------------------------------------------------------------
# Copy to .env (git-ignored) or set in your n8n host / container / secret
# manager. Every value is a PLACEHOLDER. Never commit real API keys, webhook
# URLs (a Slack / Teams webhook URL IS a credential), client names or spend data.
#
# SAFE BY DEFAULT: leaving this file untouched keeps the workflow in
# SANDBOX_MODE: provider responses are simulated, zero network calls, no
# alerts, workflow static data untouched.
# =============================================================================

# ---- n8n runtime --------------------------------------------------------------
# Required so {{ $env.X }} works. If env access is blocked the workflow falls
# back to sandbox defaults instead of failing open.
N8N_BLOCK_ENV_ACCESS_IN_NODE=false
GENERIC_TIMEZONE=UTC

# ---- Safety switches (safe defaults shown) ----------------------------------
# Safe-ON: turn off only with an explicit false/0/no/off.
SANDBOX_MODE=true
DRY_RUN=true
# true = caps and provider breakers BLOCK calls. false = monitor-only (still tracked + alerted).
CIRCUIT_BREAKER_ACTIVE_BY_DEFAULT=true
# Requests without client_key + workflow_id are rejected (no untracked spend).
REQUIRE_ATTRIBUTION=true
# Replace emails, phone and card-like numbers in prompts before they leave n8n.
REDACT_PII_BEFORE_LLM=true
# A critical-priority request skips the soft-cap downgrade (never the hard cap).
CRITICAL_BYPASSES_SOFT_CAP=true
# Safe-OFF: turn on only with an explicit true/1/yes/on.
LLM_CALLS_ENABLED=false
ALERTS_ENABLED=false
# Emergency stop: every request uses fallback rules.
LLM_KILL_SWITCH=false
# Replace an invalid (untrusted) ledger with a fresh one. Set back to false afterwards.
LEDGER_RESET=false
FORCE_ALERT=false

# ---- Daily budgets (USD; up to 9 decimals; no scientific notation) -----------
COST_CURRENCY=USD
DAILY_HARD_CAP_USD=5.00
DAILY_SOFT_CAP_PCT=80
PER_REQUEST_MAX_USD=0.25
# Hard caps are enforced at (100 - margin)% to absorb concurrent executions.
BUDGET_SAFETY_MARGIN_PCT=5
# downgrade | fallback | allow
SOFT_CAP_ACTION=downgrade
# trip_scope (overrun trips the scope for the day) | per_request
HARD_CAP_TRIP_MODE=trip_scope
# Budget day boundary as a fixed offset from UTC in minutes (e.g. 360 for UTC+6).
BUDGET_UTC_OFFSET_MINUTES=0
# Per-scope caps. Example:
# BUDGETS_JSON={"clients":{"client_alpha":{"hardUsd":"2.00","softPct":80}},"workflows":{"wf_ticket_triage":{"hardUsd":"1.00"}},"campaigns":{"camp_q4_launch":{"hardUsd":"0.50","softPct":90}},"costCenters":{"cc-marketing":{"hardUsd":"3.00"}}}
BUDGETS_JSON=

# ---- Cost allocation ----------------------------------------------------------
SHARED_COST_CENTER_KEY=shared
# Integer weights; the split is exact (largest remainder) and always sums to the cost.
SHARED_COST_ALLOCATION_JSON={"cc-marketing":60,"cc-sales":40}
# client_key -> cost center when a request has no cost_center.
COST_CENTER_MAP_JSON={}
DEFAULT_COST_CENTER=cc-unallocated

# ---- Pricing (USD per million tokens) -------------------------------------------
# Built-in table is dated PRICING_AS_OF. Verify against the provider pricing pages.
# MODEL_PRICING_JSON={"my-model":{"provider":"openai","input":"0.50","cachedInput":"0.05","output":"2.00"}}
MODEL_PRICING_JSON=
# merge (override / add models) | replace (use only MODEL_PRICING_JSON)
MODEL_PRICING_MODE=merge
PRICING_AS_OF=2026-11-17
PRICING_MAX_AGE_DAYS=60
# block (unknown model -> fallback) | max_rate (reserve at the provider's top rate)
UNPRICED_MODEL_POLICY=block
# Comma-separated allowlist; empty = every priced model.
ALLOWED_MODELS=
# Soft-cap / ceiling downgrades (same provider, cheaper only). Empty = built-in map.
DOWNGRADE_MAP_JSON=

# ---- Estimation -------------------------------------------------------------------
# Conservative: fewer chars per token = higher estimate. 3 suits current tokenizers.
CHARS_PER_TOKEN_ESTIMATE=3
PROMPT_OVERHEAD_TOKENS=16
DEFAULT_MAX_OUTPUT_TOKENS=512
MAX_OUTPUT_TOKENS_CAP=2048
SOFT_CAP_MAX_OUTPUT_TOKENS=256
MAX_INPUT_CHARS=20000
MAX_REQUESTS_PER_RUN=25

# ---- Providers -------------------------------------------------------------------
# Secrets: read only by the HTTP node headers. Never paste them into the workflow.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_BASE_URL=https://api.openai.com
ANTHROPIC_API_BASE_URL=https://api.anthropic.com
LLM_ALLOWED_HOSTS=api.openai.com,api.anthropic.com
LLM_TIMEOUT_MS=30000
MAX_RESPONSE_CHARS=8000

# ---- Provider circuit breaker ----------------------------------------------------
BREAKER_FAILURE_THRESHOLD=3
BREAKER_COOLDOWN_MINUTES=15

# ---- Fallback rules (optional overrides; validated, ReDoS-guarded) ---------------
# FALLBACK_CLASSIFY_RULES_JSON=[{"label":"billing","pattern":"\\b(invoice|refund)\\b"}]
FALLBACK_CLASSIFY_RULES_JSON=
# FALLBACK_SCORE_RULES_JSON={"base":40,"rules":[{"points":20,"pattern":"\\bdemo\\b"}],"grades":{"A":75,"B":50}}
FALLBACK_SCORE_RULES_JSON=
# FALLBACK_TEMPLATES_JSON={"general":"Thanks for your message. Reference: {{request_id}}."}
FALLBACK_TEMPLATES_JSON=
FALLBACK_SUMMARY_SENTENCES=2
FALLBACK_SUMMARY_MAX_CHARS=400

# ---- Ledger --------------------------------------------------------------------------
LEDGER_HISTORY_DAYS=14

# ---- Alerts --------------------------------------------------------------------------
# slack, teams or slack,teams
ALERT_CHANNELS=slack
# Slack incoming webhook URL (secret).
SLACK_WEBHOOK_URL=
# Teams Workflows "Post to a channel when a webhook request is received" URL (secret).
TEAMS_WEBHOOK_URL=
NOTIFY_ALLOWED_HOST_SUFFIXES=hooks.slack.com,.logic.azure.com,.powerplatform.com,.powerautomate.com
ALERT_DIGEST_ON_SCHEDULE=true
ALERT_TITLE=LLM Spend Circuit Breaker
ALERT_MAX_ROWS=5

# ---- Gateway webhook --------------------------------------------------------------------
# 16+ random characters. Header x-gateway-secret (or ?gateway_secret=).
WEBHOOK_SHARED_SECRET=

# ---- Testing ------------------------------------------------------------------------------
# Pins "now" (ISO 8601) for reproducible runs.
NOW_OVERRIDE=

